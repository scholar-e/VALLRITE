#!/usr/bin/env bash
set -u

output_dir="${1:-checkpoints/lrs3-pretrain-433h-large-image-gpu-20260923}"
interval="${2:-5}"
log_file="$output_dir/train.log"

show_gpu_status() {
  local details
  echo "GPU (name, temperature, utilization, memory used, memory total, power)"
  if command -v nvidia-smi >/dev/null 2>&1; then
    if details=$(nvidia-smi --query-gpu=name,temperature.gpu,utilization.gpu,memory.used,memory.total,power.draw \
      --format=csv,noheader 2>/dev/null); then
      printf '%s\n' "$details" | awk -F ', ' 'BEGIN {OFS=", "} {if ($2 ~ /^[0-9]+$/) $2=$2 " °C"; print}'
    else
      echo "GPU details unavailable in this shell"
    fi
  else
    echo "GPU details unavailable: nvidia-smi not found"
  fi
  echo
}

show_cpu_temperature() {
  local sensor driver input value label
  local found=0
  echo "CPU temperature"
  for sensor in /sys/class/hwmon/hwmon*; do
    [[ -r "$sensor/name" ]] || continue
    driver=$(cat "$sensor/name")
    case "$driver" in
      coretemp|k10temp|k8temp|zenpower) ;;
      *) continue ;;
    esac
    for input in "$sensor"/temp*_input; do
      [[ -r "$input" ]] || continue
      value=$(cat "$input" 2>/dev/null) || continue
      [[ "$value" =~ ^-?[0-9]+$ ]] || continue
      label="${input##*/}"
      label="${label%_input}"
      if [[ -r "${input%_input}_label" ]]; then
        label=$(cat "${input%_input}_label")
      fi
      awk -v label="$driver/$label" -v value="$value" \
        'BEGIN {printf "%s: %.1f °C\n", label, value / 1000}'
      found=1
    done
  done
  if (( ! found )); then
    echo "CPU temperature unavailable: no readable CPU hwmon sensors"
  fi
  echo
}

if [[ ! -f "$log_file" ]]; then
  echo "Missing training log: $log_file" >&2
  echo "Usage: tools/watch-visual-training OUTPUT_DIR [SECONDS]" >&2
  exit 1
fi
if [[ ! "$interval" =~ ^[0-9]+$ ]] || (( interval < 1 )); then
  echo "Refresh interval must be a positive integer" >&2
  exit 1
fi

while true; do
  clear
  now=$(date '+%Y-%m-%d %H:%M:%S %Z')
  started=$(sed -n '1{s/,.*//;p;q}' "$log_file")
  setup=$(grep 'device=.*train_clips=' "$log_file" | tail -n 1 || true)
  train_clips=$(printf '%s\n' "$setup" | sed -n 's/.*train_clips=\([0-9][0-9]*\).*/\1/p')
  latest_step=$(grep 'step=[0-9].*clips=.*running_PER=' "$log_file" | tail -n 1 || true)
  step=$(printf '%s\n' "$latest_step" | sed -n 's/.*step=\([0-9][0-9]*\).*/\1/p')
  clips=$(printf '%s\n' "$latest_step" | sed -n 's/.*clips=\([0-9][0-9]*\).*/\1/p')
  latest_epoch=$(grep 'epoch=[0-9].*validation_loss=' "$log_file" | tail -n 1 || true)
  completed_epoch=$(printf '%s\n' "$latest_epoch" | sed -n 's/.*epoch=\([0-9][0-9]*\).*/\1/p')
  log_age=$(( $(date +%s) - $(stat -c %Y "$log_file") ))
  recent_log=$(tail -n 25 "$log_file")

  echo "VisualPhoneme training monitor"
  echo "Output:  $output_dir"
  echo "Now:     $now"
  echo "Started: ${started:-waiting for log entry}"
  if [[ -f "$output_dir/PAUSE" ]]; then
    echo "Pause:   REQUESTED (PAUSE marker exists)"
  else
    echo "Pause:   not requested"
  fi
  if printf '%s\n' "$recent_log" | grep -qE 'Traceback|Error:'; then
    echo "Status:  STOPPED WITH ERROR"
  elif (( log_age > 120 )); then
    echo "Status:  no log update for ${log_age}s (finished, paused, or stalled)"
  else
    echo "Status:  active (log updated ${log_age}s ago)"
  fi
  echo

  if [[ -n "$clips" && -n "$train_clips" && "$train_clips" -gt 0 ]]; then
    percent=$(awk -v done="$clips" -v total="$train_clips" 'BEGIN {printf "%.2f", 100 * done / total}')
    current_epoch=$(( ${completed_epoch:-0} + 1 ))
    echo "Current epoch: $current_epoch"
    echo "Epoch progress: $clips / $train_clips clips ($percent%) at step $step"
  else
    echo "Epoch progress: waiting for first batch"
  fi
  echo "Last batch: ${latest_step:-none yet}"
  echo "Last validation: ${latest_epoch:-none yet}"
  if printf '%s\n' "$recent_log" | grep -qE 'Traceback|Error:'; then
    echo
    echo "Recent error"
    printf '%s\n' "$recent_log" | tail -n 12
  fi
  echo

  show_gpu_status
  show_cpu_temperature

  echo "Saved artifacts"
  find "$output_dir" -maxdepth 2 -type f \
    \( -name 'best.pt' -o -name 'resume.pt' -o -name 'epoch-*.pt' -o -name 'metrics.json' \) \
    -printf '%TY-%Tm-%Td %TH:%TM:%TS  %10s  %p\n' 2>/dev/null | sort | tail -n 12
  echo
  echo "Refreshing every ${interval}s; press Ctrl+C to stop monitoring (training continues)."
  sleep "$interval"
done
